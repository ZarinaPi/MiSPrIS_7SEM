# Переменные окружения для разработки
# Скопируйте этот файл в .env и настройте значения

# Режим работы приложения (development, production, testing)
FLASK_ENV=development

# Секретный ключ для сессий и безопасности
# В продакшене используйте надежный случайный ключ!
SECRET_KEY=dev-secret-key-change-in-production-please

# URL базы данных
DATABASE_URL=sqlite:///database.db

# Разрешенные CORS origin (через запятую)
CORS_ORIGINS=*

# Настройки пагинации
ITEMS_PER_PAGE=20
MAX_PAGE_SIZE=100

# Таймаут запросов (секунды)
REQUEST_TIMEOUT=30

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
